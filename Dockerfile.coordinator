FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder
COPY --from=ghcr.io/astral-sh/uv:0.8.11@sha256:8101ad825250a114e7bef89eefaa73c31e34e10ffbe5aff01562740bac97553c /uv /usr/local/bin/uv
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY examples/mlwe/primal-lll/solver.py ./examples/mlwe/primal-lll/solver.py
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 MLDSAFAIL_TRUSTED_CHECKOUT=/opt/mldsafail
COPY --from=docker:28.5.2-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/* && groupadd --system --gid 10001 mldsafail && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent mldsafail
WORKDIR /app
COPY --from=builder --chown=mldsafail:mldsafail /build/.venv .venv
COPY --chown=mldsafail:mldsafail alembic.ini ./
COPY --chown=mldsafail:mldsafail migrations ./migrations
COPY --chown=mldsafail:mldsafail . /opt/mldsafail
COPY --chown=mldsafail:mldsafail deploy/start-coordinator.sh ./deploy/start-coordinator.sh
RUN chmod +x ./deploy/start-coordinator.sh
USER 10001:10001
ENTRYPOINT ["./deploy/start-coordinator.sh"]

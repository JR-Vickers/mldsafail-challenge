{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mldsafail.local/schemas/0.5.0/instance-v2.json",
  "title": "MLWE instance (frozen research v2 wire contract)",
  "oneOf": [
    {
      "$ref": "#/$defs/mlwe"
    }
  ],
  "$defs": {
    "ring": {
      "type": "object",
      "required": [
        "modulus",
        "degree",
        "polynomial"
      ],
      "additionalProperties": false,
      "properties": {
        "modulus": {
          "type": "integer",
          "minimum": 3,
          "maximum": 257
        },
        "degree": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "polynomial": {
          "const": "x^n+1"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "study_version",
        "track",
        "profile",
        "instance_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "study_version": {
          "const": "primitive-selection-v2"
        },
        "profile": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mlwe": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "ring",
            "dimensions",
            "eta",
            "A",
            "t"
          ],
          "properties": {
            "track": {
              "const": "mlwe"
            },
            "ring": {
              "$ref": "#/$defs/ring"
            },
            "dimensions": {
              "type": "object"
            },
            "eta": {
              "enum": [
                1,
                2
              ]
            },
            "A": {
              "type": "array"
            },
            "t": {
              "type": "array"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}

POSTGRES_PASSWORD=replace-with-random-database-password
MLDSAFAIL_SECRET_KEY=replace-with-at-least-32-random-bytes
MLDSAFAIL_ENV=production
MLDSAFAIL_DOMAIN=mldsa.fail
GITHUB_CLIENT_ID=replace-from-github-oauth-app
GITHUB_CLIENT_SECRET=replace-from-github-oauth-app
MLDSAFAIL_EVALUATOR_FINGERPRINT=sha256-of-reviewed-evaluator-release
MLDSAFAIL_HIDDEN_SUITE_VERSION=hidden-2026-01
DOCKER_SOCKET=/run/user/1000/docker.sock
DOCKER_GID=1000
EVALUATOR_WORK_DIR=/srv/mldsafail-evaluator
EVALUATOR_UID=1000
EVALUATOR_GID=1000

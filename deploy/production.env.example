WEB_IMAGE=CHANGE_ME_IMAGE@sha256:CHANGE_ME_DIGEST
COORDINATOR_IMAGE=CHANGE_ME_IMAGE@sha256:CHANGE_ME_DIGEST
WORKER_IMAGE=CHANGE_ME_IMAGE@sha256:CHANGE_ME_DIGEST
CADDY_IMAGE=CHANGE_ME_IMAGE@sha256:CHANGE_ME_DIGEST

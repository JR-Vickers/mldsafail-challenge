# PREPARATION ONLY. Copy outside checkout, chmod 0600, replace every CHANGE_ME.
# Owner must approve public activation and measurement contract first.
POSTGRES_PASSWORD=CHANGE_ME_FRESH_DATABASE_PASSWORD
MLDSAFAIL_SECRET_KEY=CHANGE_ME_FRESH_SESSION_SECRET
GITHUB_CLIENT_ID=CHANGE_ME_PRODUCTION_OAUTH_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_PRODUCTION_OAUTH_SECRET
MLDSAFAIL_DOMAIN=178.128.17.58
PRODUCTION_ORIGIN=https://178.128.17.58
MLDSAFAIL_BENCHMARK_VERSION=0.5.0
PRODUCTION_TLS_ROOT=/srv/mldsafail-production-tls
PRODUCTION_ACME_WEBROOT=/srv/mldsafail-production-acme

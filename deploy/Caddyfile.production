https://{$MLDSAFAIL_DOMAIN} {
    tls /etc/letsencrypt/live/{$MLDSAFAIL_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$MLDSAFAIL_DOMAIN}/privkey.pem
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }
    @operations path /health/* /metrics /admin/*
    respond @operations 404
    reverse_proxy web:8000
}

http://{$MLDSAFAIL_DOMAIN} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/acme
        file_server
    }
    handle {
        redir https://{$MLDSAFAIL_DOMAIN}{uri} permanent
    }
}

[Unit]
Description=Weekly encrypted recovery integrity check
[Service]
Type=oneshot
User=mldsafail
UMask=0077
WorkingDirectory=/srv/mldsafail/current
ExecStart=/srv/mldsafail/current/.venv/bin/python -m deploy.recovery check --config /srv/mldsafail/secrets/recovery.json
TimeoutStartSec=4h
NoNewPrivileges=true

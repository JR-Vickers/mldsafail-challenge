{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mldsafail.local/schemas/primitive-selection/result-v1.json",
  "title": "Primitive selection result",
  "type": "object",
  "required": [
    "schema_version", "study_version", "git_revision", "container_image_digest", "host",
    "track", "profile", "seed", "eta", "solver", "solver_parameters", "verification_result",
    "failure_reason", "median_wall_seconds", "median_cpu_seconds", "peak_rss_bytes",
    "answer_quality", "timeout", "memory_limit", "diagnostic_counters", "input_digest",
    "output_digest", "source_digest", "repetitions"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "study_version": {"const": "primitive-selection-v1"},
    "track": {"enum": ["mlwe", "msis", "bkz"]},
    "profile": {"enum": ["small", "medium", "large"]},
    "eta": {"enum": [1, 2]},
    "verification_result": {"type": "boolean"},
    "timeout": {"type": "boolean"},
    "memory_limit": {"type": "boolean"},
    "peak_rss_bytes": {"type": "integer", "minimum": 0},
    "repetitions": {"type": "array", "minItems": 1}
  }
}

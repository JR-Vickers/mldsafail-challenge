FROM python:3.12.10-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:0.8.11 /uv /usr/local/bin/uv
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12.10-slim-bookworm
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
RUN groupadd --system --gid 65532 worker && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent worker
WORKDIR /app
COPY --from=builder --chown=65532:65532 /build/.venv .venv
USER 65532:65532
ENTRYPOINT ["python", "-m", "mldsafail.evaluator.worker"]
